{
  "name": "dict",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite --host --port 8470",
    "dev:pc": "tauri dev --no-dev-server",
    "dev:android": "tauri android dev --host 192.168.1.5 --no-dev-server",
    "dev:ios": "tauri ios dev",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && bun test server",
    "serve": "bun server/index.ts",
    "build:pc": "VITE_API_BASE=http://127.0.0.1:8471 tauri build",
    "build:android": "VITE_API_BASE=http://127.0.0.1:8471 tauri android build",
    "build:ios": "tauri ios build",
    "init:android": "tauri android init",
    "preview": "vite preview",
    "tauri": "tauri",
    "collect-words": "bun scripts/collect-words"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@ruinb0w/ui": "file:../ui",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "dexie": "^4.3.0",
    "pinia": "^4.0.3",
    "uuid": "^9.0.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.12"
  }
}
