{
  "name": "dict",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite --host --port 8470",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && bun test server",
    "serve": "bun server/index.ts --port 8470",
    "preview": "vite preview",
    "collect-words": "bun scripts/collect-words"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@ruinb0w/ui": "file:../ui",
    "pinia": "^4.0.3",
    "uuid": "^9.0.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.12"
  }
}
